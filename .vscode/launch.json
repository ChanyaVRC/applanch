{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Applanch",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "applanch: Build App",
            "program": "${workspaceFolder}/src/applanch/bin/Debug/net10.0-windows10.0.22000.0/applanch.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "Debug Docs",
            "type": "node-terminal",
            "request": "launch",
            "command": "& \"$env:LOCALAPPDATA\\Programs\\Python\\Python314\\python.exe\" -m mkdocs serve",
            "cwd": "${workspaceFolder}/docs",
            "serverReadyAction": {
                "pattern": "Serving on (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Smart: Docs or applanch",
            "type": "node-terminal",
            "request": "launch",
            "command": "$activeFile = ('${relativeFile}' -replace '\\\\', '/').ToLowerInvariant(); if ($activeFile.StartsWith('docs/')) { & \"$env:LOCALAPPDATA\\Programs\\Python\\Python314\\python.exe\" -m mkdocs serve; exit $LASTEXITCODE } else { dotnet run --project src/applanch/applanch.csproj; exit $LASTEXITCODE }",
            "cwd": "${workspaceFolder}",
            "serverReadyAction": {
                "pattern": "Serving on (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}
