<Window
    x:Class="applanch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:applanch.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:applanch"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:applanch.Properties"
    xmlns:vm="clr-namespace:applanch.ViewModels"
    xmlns:wpf="clr-namespace:applanch.Infrastructure.Wpf"
    Title="Applanch"
    Width="840"
    Height="560"
    MinWidth="700"
    MinHeight="480"
    Background="{DynamicResource Brush.AppBackground}"
    Loaded="MainWindow_Loaded"
    SourceInitialized="Window_SourceInitialized"
    mc:Ignorable="d">
    <Window.Resources>
        <wpf:CategoryDisplayConverter x:Key="CategoryDisplayConverter" />
        <Style x:Key="CategorySidebarHoverZoneStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=CategorySidebarPinToggleButton}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategorySidebarContainerStyle" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="12" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategorySidebarExpandedContentStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCategorySidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MainContentContainerStyle" TargetType="Grid">
            <Setter Property="Margin" Value="{x:Static local:MainWindow.CategorySidebarPinnedContentMargin}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned, ElementName=CategorySidebar}" Value="False">
                    <Setter Property="Margin" Value="0" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ThicknessAnimation
                                    Storyboard.TargetProperty="Margin"
                                    To="0"
                                    Duration="{x:Static local:MainWindow.CategorySidebarAnimationDuration}">
                                    <ThicknessAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ThicknessAnimation
                                    Storyboard.TargetProperty="Margin"
                                    To="{x:Static local:MainWindow.CategorySidebarPinnedContentMargin}"
                                    Duration="{x:Static local:MainWindow.CategorySidebarAnimationDuration}">
                                    <ThicknessAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseInOut" />
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ItemBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="16"
                                    Opacity="0.18"
                                    ShadowDepth="4"
                                    Color="#000000" />
                            </Border.Effect>
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border
                            x:Name="MenuItemBorder"
                            Margin="2,1"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Header}"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource Brush.ItemBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource Brush.ItemBorder}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}" TargetType="Separator" />

        <Style
            x:Key="RoundedSecondaryButtonStyle"
            BasedOn="{StaticResource RoundedButtonStyle}"
            TargetType="Button" />

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderToggleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="Track"
                                Grid.Column="2"
                                Width="38"
                                Height="22"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.ItemBorder}"
                                BorderThickness="1"
                                CornerRadius="11">
                                <Ellipse
                                    x:Name="Thumb"
                                    Width="16"
                                    Height="16"
                                    Margin="2"
                                    HorizontalAlignment="Left"
                                    Fill="{DynamicResource Brush.TextTertiary}" />
                            </Border>
                            <ContentPresenter
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1A6DB3F8" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#6DB3F8" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#6DB3F8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#8DBFFB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LaunchTileButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="TileBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource Brush.Surface}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.ItemBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.ItemBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Implicit style makes this the default for ALL ComboBoxItems,
            overriding the WPF theme style that has FindAncestor bindings.
        -->
        <Style BasedOn="{StaticResource ModernComboBoxItemStyle}" TargetType="ComboBoxItem" />

        <Style x:Key="ModernComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" BorderThickness="0">
                            <Path
                                Width="10"
                                Height="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 0 0 L 5 6 L 10 0"
                                Stroke="{DynamicResource Brush.TextTertiary}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.6" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ItemBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border
                                x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        x:Name="ContentSite"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        IsHitTestVisible="False" />

                                    <TextBox
                                        x:Name="PART_EditableTextBox"
                                        Grid.Column="0"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CaretBrush="{DynamicResource Brush.TextPrimary}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Visibility="Hidden" />

                                    <ToggleButton
                                        Grid.Column="1"
                                        ClickMode="Press"
                                        Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Style="{StaticResource ModernComboBoxToggleButtonStyle}" />
                                </Grid>
                            </Border>

                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Fade">
                                <Border
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="240"
                                    Margin="0,6,0,0"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.ItemBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Brush.SurfaceBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Brush.SurfaceBorder}" />
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource Brush.ItemBackground}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Brush.SurfaceBorder}" />
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource Brush.ItemBackground}" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="QuickAddCompactComboBoxStyle"
            BasedOn="{StaticResource ModernComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3" />
        </Style>

        <Style
            x:Key="ModernTextBoxStyle"
            BasedOn="{StaticResource RoundedTextBoxStyle}"
            TargetType="TextBox" />

        <Style
            x:Key="QuickAddCompactTextBoxStyle"
            BasedOn="{StaticResource ModernTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style x:Key="ModernScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            x:Name="ThumbBorder"
                            Background="{DynamicResource Brush.ScrollbarThumb}"
                            CornerRadius="3"
                            Opacity="0.45" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="6" Margin="0,2">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ModernScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ModernScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Margin="1,0" Style="{StaticResource ModernScrollBarThumbStyle}" />
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="6" Margin="2,0">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ModernScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ModernScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Margin="0,1" Style="{StaticResource ModernScrollBarThumbStyle}" />
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6" />
                    <Setter Property="MinWidth" Value="6" />
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6" />
                    <Setter Property="MinHeight" Value="6" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:FloatingNotificationControl
            x:Name="FloatingNotification"
            Grid.Row="0"
            Grid.RowSpan="4"
            Panel.ZIndex="20"
            ActionRequested="FloatingNotification_ActionRequested"
            ActionText="{Binding FloatingNotification.ActionText}"
            ActionVisibility="{Binding FloatingNotification.ActionVisibility}"
            Hidden="FloatingNotification_Hidden"
            IconType="{Binding FloatingNotification.IconType}"
            Message="{Binding FloatingNotification.Message}" />

        <controls:HeaderBarControl
            Grid.Row="0"
            IsUpdateButtonEnabled="{Binding UpdateBanner.AreUpdateActionsEnabled}"
            SettingsRequested="SettingsButton_Click"
            UpdateButtonVisibility="{Binding UpdateBanner.HeaderButtonVisibility}"
            UpdateRequested="UpdateButton_Click" />

        <controls:UpdateBannerControl
            Grid.Row="1"
            Margin="0,8,0,0"
            DismissRequested="DismissUpdateButton_Click"
            IsUpdateActionButtonEnabled="{Binding UpdateBanner.AreUpdateActionsEnabled}"
            Message="{Binding UpdateBanner.Message}"
            UpdateActionButtonVisibility="{Binding UpdateBanner.ActionButtonVisibility}"
            UpdateRequested="UpdateButton_Click"
            Visibility="{Binding UpdateBanner.BannerVisibility}" />

        <Grid Grid.Row="3">
            <controls:CategorySidebarControl
                x:Name="CategorySidebar"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Panel.ZIndex="1"
                CreateDropTargetDragLeave="CategorySidebarCreateDropTarget_DragLeave"
                CreateDropTargetDragOver="CategorySidebarCreateDropTarget_DragOver"
                CreateDropTargetDrop="CategorySidebarCreateDropTarget_Drop"
                PinToggleClick="CategorySidebarPinToggleButton_Click"
                SidebarDragLeave="CategorySidebarContainer_DragLeave"
                SidebarDragOver="CategorySidebarContainer_DragOver"
                SidebarDrop="CategorySidebarContainer_Drop" />

            <Grid x:Name="MainContentContainer" Style="{StaticResource MainContentContainerStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Expander
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalContentAlignment="Stretch"
                        Foreground="{DynamicResource Brush.TextPrimary}">
                        <Expander.Header>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Expander_AddApp]}" />
                        </Expander.Header>
                        <Border
                            Margin="0,8,0,0"
                            Padding="12"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.ItemBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <controls:SuggestionInputControl
                                    InputComboBoxStyle="{StaticResource ModernComboBoxStyle}"
                                    Placeholder="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_NameOrPath]}"
                                    Suggestions="{Binding QuickAddSuggestions}"
                                    Text="{Binding QuickAddNameOrPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_NameOrPath]}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <controls:SuggestionInputControl
                                        Grid.Column="0"
                                        InputComboBoxStyle="{StaticResource QuickAddCompactComboBoxStyle}"
                                        Placeholder="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_Category]}"
                                        Suggestions="{Binding CategoryNames, Converter={StaticResource CategoryDisplayConverter}}"
                                        Text="{Binding QuickAddCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CategoryDisplayConverter}}"
                                        ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_Category]}" />
                                    <Grid Grid.Column="2">
                                        <TextBox
                                            x:Name="QuickAddArgumentsTextBox"
                                            Style="{StaticResource QuickAddCompactTextBoxStyle}"
                                            Text="{Binding QuickAddArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_Arguments]}" />
                                        <TextBlock
                                            Margin="12,0,10,0"
                                            VerticalAlignment="Center"
                                            Foreground="#7F8A95"
                                            IsHitTestVisible="False"
                                            Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_Arguments]}"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding QuickAddArguments}" Value="" />
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=QuickAddArgumentsTextBox}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button
                                        Grid.Column="4"
                                        Height="28"
                                        Click="QuickAddButton_Click"
                                        Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Button_Add]}"
                                        Style="{StaticResource RoundedSecondaryButtonStyle}" />
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource Brush.TextTertiary}"
                                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Hint_AddApp]}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding QuickAddFeedback.Message}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding QuickAddFeedback.MessageVisibility}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.QuickAddInfoText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuickAddFeedback.Severity}" Value="{x:Static vm:QuickAddMessageSeverity.Warning}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.QuickAddWarningText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Expander>
                    <CheckBox
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        Click="IconModeToggleButton_Click"
                        Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Button_IconMode]}"
                        IsChecked="{Binding IsLaunchItemIconOnlyMode, Mode=OneWay}"
                        Style="{StaticResource HeaderToggleCheckBoxStyle}"
                        ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_ToggleLaunchItemIconOnlyMode]}" />
                </Grid>

                <Grid Grid.Row="3">
                    <ListBox
                        x:Name="LaunchListBox"
                        HorizontalContentAlignment="Stretch"
                        AllowDrop="True"
                        Background="Transparent"
                        BorderThickness="0"
                        DragOver="LaunchListBox_DragOver"
                        Drop="LaunchListBox_Drop"
                        ItemsSource="{Binding FilteredLaunchItems}"
                        PreviewMouseLeftButtonDown="LaunchListBox_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="LaunchListBox_PreviewMouseMove"
                        PreviewMouseWheel="LaunchListBox_PreviewMouseWheel"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedLaunchItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLaunchItemIconOnlyMode}" Value="True">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <controls:VirtualizingWrapPanel ItemWidth="82" />
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="ItemContainerBorder"
                                                Margin="1"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemContainerBorder" Property="BorderBrush" Value="{DynamicResource Brush.ItemBorder}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemContainerBorder" Property="BorderBrush" Value="{DynamicResource Brush.SurfaceBorder}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsLaunchItemIconOnlyMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8,6"
                                    Background="{DynamicResource Brush.ItemBackground}"
                                    BorderBrush="{DynamicResource Brush.ItemBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsLaunchItemIconOnlyMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Width" Value="72" />
                                                    <Setter Property="Padding" Value="10" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Click="ContextMenu_Item_Click"
                                                Header="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Menu_Rename]}"
                                                Tag="{x:Static local:LaunchItemContextMenuAction.Rename}" />
                                            <MenuItem
                                                Click="ContextMenu_Item_Click"
                                                Header="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Menu_ChangeCategory]}"
                                                Tag="{x:Static local:LaunchItemContextMenuAction.EditCategory}" />
                                            <MenuItem
                                                Click="ContextMenu_Item_Click"
                                                Header="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Menu_ChangeArguments]}"
                                                Tag="{x:Static local:LaunchItemContextMenuAction.EditArguments}" />
                                            <MenuItem
                                                Click="ContextMenu_Item_Click"
                                                Header="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Menu_OpenFileLocation]}"
                                                Tag="{x:Static local:LaunchItemContextMenuAction.OpenLocation}" />
                                            <Separator />
                                            <MenuItem
                                                Click="ContextMenu_Item_Click"
                                                Header="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Menu_Delete]}"
                                                Tag="{x:Static local:LaunchItemContextMenuAction.Delete}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsLaunchItemIconOnlyMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Brush.TextTertiary}"
                                                Text="::"
                                                ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_DragToReorder]}" />

                                            <Button
                                                Grid.Column="2"
                                                Click="LaunchItemButton_Click"
                                                Tag="{Binding}"
                                                ToolTip="{Binding DisplayName}">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource LaunchTileButtonStyle}" TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Grid.RowSpan="2"
                                                        Grid.Column="0"
                                                        Width="28"
                                                        Height="28"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource Brush.IconBackground}"
                                                        CornerRadius="5">
                                                        <Grid>
                                                            <Image
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Source="{Binding IconSource}" />
                                                            <TextBlock
                                                                Margin="0,0,-1,-1"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource Brush.MissingPathWarningBadge}"
                                                                Text="&#xE7BA;"
                                                                ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_MissingPath]}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPathMissing}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Text="{Binding DisplayName}" />

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="2"
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource Brush.TextTertiary}"
                                                        Text="{Binding FullPath}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>

                                            <Grid Grid.Column="2" Margin="8">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.RowSpan="2"
                                                    Grid.Column="0"
                                                    Width="28"
                                                    Height="28"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource Brush.IconBackground}"
                                                    CornerRadius="5">
                                                    <Grid>
                                                        <Image
                                                            Width="16"
                                                            Height="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Source="{Binding IconSource}" />
                                                        <TextBlock
                                                            Margin="0,0,-1,-1"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="10"
                                                            Foreground="{DynamicResource Brush.MissingPathWarningBadge}"
                                                            Text="&#xE7BA;"
                                                            ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_MissingPath]}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPathMissing}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>

                                                <TextBox
                                                    Grid.Column="2"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                                    IsVisibleChanged="RenameTextBox_IsVisibleChanged"
                                                    KeyDown="RenameTextBox_KeyDown"
                                                    LostFocus="RenameTextBox_LostFocus"
                                                    Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="0,2,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource Brush.TextTertiary}"
                                                    Text="{Binding FullPath}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <Button
                                                Grid.Column="3"
                                                Click="DeleteButton_Click"
                                                Content="×"
                                                Tag="{Binding}">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource HeaderIconButtonStyle}" TargetType="Button">
                                                        <Setter Property="Width" Value="26" />
                                                        <Setter Property="Height" Value="26" />
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="ToolTip" Value="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_Delete]}" />
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <Button
                                            Width="60"
                                            Height="60"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="LaunchItemButton_Click"
                                            Tag="{Binding}"
                                            ToolTip="{Binding DisplayName}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource LaunchTileButtonStyle}" TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Padding" Value="6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsLaunchItemIconOnlyMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Border
                                                    Width="44"
                                                    Height="44"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource Brush.IconBackground}"
                                                    CornerRadius="9">
                                                    <Grid>
                                                        <Image
                                                            Width="28"
                                                            Height="28"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Source="{Binding IconSource}" />
                                                        <TextBlock
                                                            Margin="0,0,0,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="12"
                                                            Foreground="{DynamicResource Brush.MissingPathWarningBadge}"
                                                            Text="&#xE7BA;"
                                                            ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_MissingPath]}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPathMissing}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border
                        Padding="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.ItemBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding EmptyMessageVisibility}">
                        <TextBlock
                            FontSize="13"
                            Foreground="{DynamicResource Brush.TextTertiary}"
                            Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[EmptyMessage]}"
                            TextAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
