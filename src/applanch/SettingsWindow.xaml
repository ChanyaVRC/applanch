<Window
    x:Class="applanch.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:applanch"
    xmlns:core="clr-namespace:applanch.Localization;assembly=applanch.Core"
    xmlns:res="clr-namespace:applanch.Properties"
    xmlns:storage="clr-namespace:applanch.Settings;assembly=applanch.Core"
    Title="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Window_Settings]}"
    Width="480"
    Height="560"
    Background="{DynamicResource Brush.AppBackground}"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Manual"
    SourceInitialized="Window_SourceInitialized"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style
            x:Key="SettingsComboBoxStyle"
            BasedOn="{StaticResource RoundedComboBoxStyle}"
            TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,3" />
        </Style>

        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="Track"
                                Grid.Column="2"
                                Width="42"
                                Height="24"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.ItemBorder}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Ellipse
                                    x:Name="Thumb"
                                    Width="18"
                                    Height="18"
                                    Margin="2"
                                    HorizontalAlignment="Left"
                                    Fill="{DynamicResource Brush.TextTertiary}" />
                            </Border>
                            <ContentPresenter
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1A6DB3F8" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#6DB3F8" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#6DB3F8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#8DBFFB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border
                            x:Name="ThumbBorder"
                            Background="{DynamicResource Brush.ScrollbarThumb}"
                            CornerRadius="3"
                            Opacity="0.45" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="6" Margin="0,2">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ModernScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ModernScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Margin="1,0" Style="{StaticResource ModernScrollBarThumbStyle}" />
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="6" Margin="2,0">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ModernScrollBarPageButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ModernScrollBarPageButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Margin="0,1" Style="{StaticResource ModernScrollBarThumbStyle}" />
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6" />
                    <Setter Property="MinWidth" Value="6" />
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6" />
                    <Setter Property="MinHeight" Value="6" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>


    </Window.Resources>

    <DockPanel>
        <Border
            Padding="20,12"
            BorderBrush="{DynamicResource Brush.ItemBorder}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Click="ResetToDefaults_Click"
                    Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Button_ResetToDefaults]}"
                    Style="{StaticResource RoundedButtonStyle}" />

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource Brush.TextTertiary}"
                        Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Label_Version]}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.TextTertiary}"
                        Text="{Binding AppVersion}" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Click="ReportBug_Click"
                    Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Button_ReportBug]}"
                    Style="{StaticResource RoundedButtonStyle}"
                    ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_ReportBug]}" />
            </Grid>
        </Border>

        <ScrollViewer
            CanContentScroll="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Section_Appearance]}" />

                <Border
                    Margin="0,10,0,20"
                    Padding="14,12"
                    Background="{DynamicResource Brush.ItemBackground}"
                    BorderBrush="{DynamicResource Brush.ItemBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_Theme]}"
                            Visibility="{Binding IsThemeSelectionVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="200"
                            Margin="12,0,0,0"
                            IsEditable="False"
                            ItemsSource="{Binding ThemeOptions}"
                            SelectedValue="{Binding SelectedThemeId}"
                            SelectedValuePath="ThemeId"
                            Style="{StaticResource SettingsComboBoxStyle}"
                            Text="{Binding SelectedThemeDisplayName, Mode=OneWay}"
                            TextSearch.TextPath="DisplayName"
                            Visibility="{Binding IsThemeSelectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_Language]}" />

                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="200"
                            Margin="12,0,0,0"
                            SelectedValue="{Binding SelectedLanguage}"
                            SelectedValuePath="Tag"
                            Style="{StaticResource SettingsComboBoxStyle}">
                            <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Language_System]}" Tag="{x:Static core:LanguageOption.System}" />
                            <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Language_English]}" Tag="{x:Static core:LanguageOption.English}" />
                            <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Language_Japanese]}" Tag="{x:Static core:LanguageOption.Japanese}" />
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Section_Behavior]}" />

                <Border
                    Margin="0,10,0,20"
                    Padding="14,12"
                    Background="{DynamicResource Brush.ItemBackground}"
                    BorderBrush="{DynamicResource Brush.ItemBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[SettingGroup_StartupAndIntegration]}" />

                        <StackPanel Margin="12,0,0,0">

                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_StartMinimizedOnLaunch]}"
                                IsChecked="{Binding StartMinimizedOnLaunch}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_StartMinimizedOnLaunchDesc]}"
                                TextWrapping="Wrap" />

                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_LaunchAtWindowsStartup]}"
                                IsChecked="{Binding LaunchAtWindowsStartup}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_LaunchAtWindowsStartupDesc]}"
                                TextWrapping="Wrap" />

                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_RegisterContextMenuOnStartup]}"
                                IsChecked="{Binding RegisterContextMenuOnStartup}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_RegisterContextMenuOnStartupDesc]}"
                                TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_RemoveContextMenuRegistration]}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right"
                                    Click="RemoveContextMenuRegistration_Click"
                                    Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Menu_Delete]}"
                                    Style="{StaticResource RoundedButtonStyle}" />
                            </Grid>
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_RemoveContextMenuRegistrationDesc]}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="0,14,0,12"
                            Background="{DynamicResource Brush.ItemBorder}" />

                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[SettingGroup_IconsAndNetwork]}" />

                        <StackPanel Margin="12,0,0,0">

                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_FetchHttpIcons]}"
                                IsChecked="{Binding FetchHttpIcons}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_FetchHttpIconsDesc]}"
                                TextWrapping="Wrap" />

                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_AllowPrivateNetworkHttpIconRequests]}"
                                IsChecked="{Binding AllowPrivateNetworkHttpIconRequests}"
                                IsEnabled="{Binding FetchHttpIcons}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_AllowPrivateNetworkHttpIconRequestsDesc]}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="0,14,0,12"
                            Background="{DynamicResource Brush.ItemBorder}" />

                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[SettingGroup_LaunchActions]}" />

                        <StackPanel Margin="12,0,0,0">

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_PostLaunchBehavior]}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    SelectedValue="{Binding SelectedPostLaunchBehavior}"
                                    SelectedValuePath="Tag"
                                    Style="{StaticResource SettingsComboBoxStyle}">
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[PostLaunchBehavior_Close]}" Tag="{x:Static storage:PostLaunchBehavior.CloseApp}" />
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[PostLaunchBehavior_Minimize]}" Tag="{x:Static storage:PostLaunchBehavior.MinimizeWindow}" />
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[PostLaunchBehavior_KeepOpen]}" Tag="{x:Static storage:PostLaunchBehavior.KeepOpen}" />
                                </ComboBox>
                            </Grid>

                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_ConfirmBeforeLaunch]}"
                                IsChecked="{Binding ConfirmBeforeLaunch}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />
                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_ConfirmBeforeDelete]}"
                                IsChecked="{Binding ConfirmBeforeDelete}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />

                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_RunAsAdministrator]}"
                                IsChecked="{Binding RunAsAdministrator}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />

                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="0,14,0,12"
                            Background="{DynamicResource Brush.ItemBorder}" />

                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[SettingGroup_ListsAndSorting]}" />

                        <StackPanel Margin="12,0,0,0">

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_QuickAddSuggestionLimit]}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    ItemsSource="{Binding QuickAddSuggestionLimitOptions}"
                                    SelectedItem="{Binding QuickAddSuggestionLimit}"
                                    Style="{StaticResource SettingsComboBoxStyle}" />
                            </Grid>
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_QuickAddSuggestionLimitDesc]}"
                                TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_CategorySortMode]}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    SelectedValue="{Binding SelectedCategorySortMode}"
                                    SelectedValuePath="Tag"
                                    Style="{StaticResource SettingsComboBoxStyle}">
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[SortMode_Alphabetical]}" Tag="{x:Static storage:CategorySortMode.Alphabetical}" />
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[SortMode_AsAdded]}" Tag="{x:Static storage:CategorySortMode.AsAdded}" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_AppListSortMode]}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    SelectedValue="{Binding SelectedAppListSortMode}"
                                    SelectedValuePath="Tag"
                                    Style="{StaticResource SettingsComboBoxStyle}">
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[AppListSort_Manual]}" Tag="{x:Static storage:AppListSortMode.Manual}" />
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[AppListSort_Name]}" Tag="{x:Static storage:AppListSortMode.Name}" />
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[AppListSort_CategoryThenName]}" Tag="{x:Static storage:AppListSortMode.CategoryThenName}" />
                                </ComboBox>
                            </Grid>

                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_LaunchItemIconOnlyMode]}"
                                IsChecked="{Binding LaunchItemIconOnlyMode}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_LaunchItemIconOnlyModeDesc]}"
                                TextWrapping="Wrap" />

                        </StackPanel>

                        <Border
                            Height="1"
                            Margin="0,14,0,12"
                            Background="{DynamicResource Brush.ItemBorder}" />

                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[SettingGroup_Updates]}" />

                        <StackPanel Margin="12,0,0,0">

                            <CheckBox
                                Margin="0,10,0,0"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_CheckForUpdates]}"
                                IsChecked="{Binding CheckForUpdatesOnStartup}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_CheckForUpdatesDesc]}"
                                TextWrapping="Wrap" />

                            <CheckBox
                                Margin="0,10,0,0"
                                Click="AllowPrereleaseUpdates_Click"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_AllowPrereleaseUpdates]}"
                                IsChecked="{Binding AllowPrereleaseUpdates}"
                                Style="{StaticResource SettingsCheckBoxStyle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource Brush.TextTertiary}"
                                Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_AllowPrereleaseUpdatesDesc]}"
                                TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_AvailableVersion]}" />
                                <ComboBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    DisplayMemberPath="NewVersion"
                                    ItemsSource="{Binding AvailableUpdates}"
                                    SelectedItem="{Binding SelectedAvailableUpdate}"
                                    Style="{StaticResource SettingsComboBoxStyle}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource Brush.TextTertiary}"
                                    Text="{Binding AvailableUpdatesStatusMessage}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="12,6,0,0"
                                    HorizontalAlignment="Right"
                                    Click="ApplySelectedVersion_Click"
                                    Content="{Binding ApplySelectedVersionButtonText}"
                                    IsEnabled="{Binding CanApplySelectedUpdate}"
                                    Style="{StaticResource RoundedButtonStyle}" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_UpdateInstallBehavior]}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="200"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    SelectedValue="{Binding SelectedUpdateInstallBehavior}"
                                    SelectedValuePath="Tag"
                                    Style="{StaticResource SettingsComboBoxStyle}">
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[UpdateInstallBehavior_NotifyOnly]}" Tag="{x:Static storage:UpdateInstallBehavior.NotifyOnly}" />
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[UpdateInstallBehavior_Manual]}" Tag="{x:Static storage:UpdateInstallBehavior.Manual}" />
                                    <ComboBoxItem Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[UpdateInstallBehavior_Auto]}" Tag="{x:Static storage:UpdateInstallBehavior.AutomaticallyApply}" />
                                </ComboBox>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Section_Debug]}" />

                <Border
                    Margin="0,10,0,0"
                    Padding="14,12"
                    Background="{DynamicResource Brush.ItemBackground}"
                    BorderBrush="{DynamicResource Brush.ItemBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <CheckBox
                            Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_DebugUpdate]}"
                            IsChecked="{Binding DebugUpdate}"
                            Style="{StaticResource SettingsCheckBoxStyle}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource Brush.TextTertiary}"
                            Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Setting_DebugUpdateDesc]}"
                            TextWrapping="Wrap" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Click="CopyDiagnostics_Click"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Button_CopyDiagnostics]}"
                                Style="{StaticResource RoundedButtonStyle}" />

                            <Button
                                Grid.Column="2"
                                Click="OpenLogFolder_Click"
                                Content="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Button_OpenLogFolder]}"
                                Style="{StaticResource RoundedButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

