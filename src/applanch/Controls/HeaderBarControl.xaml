<UserControl
    x:Class="applanch.Controls.HeaderBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:applanch"
    xmlns:res="clr-namespace:applanch.Properties"
    x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="HeaderFlatHoverTextButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border
        Padding="14,12"
        Background="{DynamicResource Brush.ItemBackground}"
        BorderBrush="{DynamicResource Brush.ItemBorder}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="TitleArea"
                Grid.Column="0"
                HorizontalAlignment="Left"
                IsHitTestVisible="False">
                <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        Text="Applanch" />
                    <TextBlock
                        x:Name="AppVersionTextBlock"
                        Grid.Column="1"
                        Margin="8,0,0,1"
                        VerticalAlignment="Bottom"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.TextTertiary}"
                        Text="{Binding AppVersionText, ElementName=Root}" />
                    <Border
                        x:Name="PrereleaseBadge"
                        Grid.Column="2"
                        Margin="10,0,0,2"
                        Padding="7,2"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Brush.PrereleaseBadgeBackground}"
                        BorderBrush="{DynamicResource Brush.PrereleaseBadgeBorder}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Visibility="{Binding IsPrereleaseVersion, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.PrereleaseBadgeText}"
                            Text="PRERELEASE" />
                    </Border>
                </Grid>
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[Subtitle]}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    x:Name="UpdateButton"
                    Margin="0,0,8,0"
                    Click="UpdateButton_Click"
                    Content="⭳"
                    FontSize="14"
                    FontWeight="SemiBold"
                    IsEnabled="{Binding IsUpdateButtonEnabled, ElementName=Root}"
                    Style="{StaticResource HeaderFlatHoverTextButtonStyle}"
                    ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_Update]}"
                    Visibility="{Binding UpdateButtonVisibility, ElementName=Root}" />
                <Button
                    Click="SettingsButton_Click"
                    Content="⚙"
                    FontSize="16"
                    Style="{StaticResource HeaderFlatHoverTextButtonStyle}"
                    ToolTip="{Binding Source={x:Static local:LocalizedStrings.Instance}, Path=[ToolTip_Settings]}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
