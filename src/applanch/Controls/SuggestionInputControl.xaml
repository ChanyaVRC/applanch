<UserControl
    x:Class="applanch.Controls.SuggestionInputControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    Loaded="SuggestionInputControl_Loaded"
    Unloaded="SuggestionInputControl_Unloaded">
    <ComboBox
        x:Name="InputComboBox"
        IsEditable="True"
        IsTextSearchEnabled="False"
        ItemsSource="{Binding FilteredSuggestions, ElementName=Root}"
        PreviewMouseLeftButtonUp="ComboBox_PreviewMouseLeftButtonUp"
        SelectionChanged="ComboBox_SelectionChanged"
        StaysOpenOnEdit="True"
        Style="{Binding InputComboBoxStyle, ElementName=Root}"
        Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        ToolTip="{Binding ToolTip, ElementName=Root}" />
</UserControl>
