<dialogs:DialogWindowBase
    x:Class="applanch.Views.Dialogs.PromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:applanch"
    xmlns:controls="clr-namespace:applanch.Controls"
    xmlns:dialogs="clr-namespace:applanch.Views.Dialogs"
    xmlns:res="clr-namespace:applanch.Properties"
    Width="420"
    Background="{DynamicResource Brush.AppBackground}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height">
    <dialogs:DialogWindowBase.Resources>

        <!--  Item inside the dropdown list  -->
        <Style x:Key="DialogComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ItemBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.ItemBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Implicit style overrides the WPF theme style that has FindAncestor bindings.  -->
        <Style BasedOn="{StaticResource DialogComboBoxItemStyle}" TargetType="ComboBoxItem" />

        <!--  ComboBox styled to match the TextBox  -->
        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ItemBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DialogComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!--  Visible border, identical to DialogTextBoxStyle  -->
                            <Border
                                x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <Grid>
                                    <!--  Editable text area  -->
                                    <TextBox
                                        x:Name="PART_EditableTextBox"
                                        MinHeight="0"
                                        Margin="10,0,30,0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CaretBrush="{DynamicResource Brush.TextPrimary}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}" />
                                    <!--  Real toggle button so the control behaves as a true ComboBox  -->
                                    <ToggleButton
                                        x:Name="DropDownToggle"
                                        Width="28"
                                        Margin="0"
                                        HorizontalAlignment="Right"
                                        ClickMode="Press"
                                        Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Style="{StaticResource DialogComboBoxToggleButtonStyle}">
                                        <Path
                                            Width="12"
                                            Height="8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M 1 1 L 6 7 L 11 1"
                                            Stroke="{DynamicResource Brush.TextTertiary}"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.4" />
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!--  Dropdown popup — WPF manages placement automatically  -->
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Fade"
                                VerticalOffset="4">
                                <Border
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="200"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.ItemBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <ScrollViewer
                                        Margin="4"
                                        Focusable="False"
                                        SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Brush.SurfaceBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Brush.SurfaceBorder}" />
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource Brush.ItemBackground}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Brush.SurfaceBorder}" />
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource Brush.ItemBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Plain text input  -->
        <Style
            x:Key="DialogTextBoxStyle"
            BasedOn="{StaticResource RoundedTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </dialogs:DialogWindowBase.Resources>

    <StackPanel Margin="20">
        <!--  Text-only mode  -->
        <TextBox x:Name="InputTextBox" Text="{Binding InitialValue, Mode=OneWay}">
            <TextBox.Style>
                <Style BasedOn="{StaticResource DialogTextBoxStyle}" TargetType="TextBox">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UseSuggestions}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <!--  Suggestion mode: SuggestionInputControl wraps ComboBox logic  -->
        <controls:SuggestionInputControl
            x:Name="InputSuggestion"
            InputComboBoxStyle="{StaticResource DialogComboBoxStyle}"
            Suggestions="{Binding SuggestionTexts, Mode=OneWay}"
            Text="{Binding InitialValue, Mode=OneWay}">
            <controls:SuggestionInputControl.Style>
                <Style TargetType="controls:SuggestionInputControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UseSuggestions}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:SuggestionInputControl.Style>
        </controls:SuggestionInputControl>
        <StackPanel
            Margin="0,14,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="CancelButton"
                Width="100"
                Content="{Binding Source={x:Static app:LocalizedStrings.Instance}, Path=[Button_Cancel]}"
                IsCancel="True" />
            <Button
                x:Name="OkButton"
                Width="80"
                Margin="8,0,0,0"
                Click="OkButton_Click"
                Content="OK"
                IsDefault="True" />
        </StackPanel>
    </StackPanel>
</dialogs:DialogWindowBase>