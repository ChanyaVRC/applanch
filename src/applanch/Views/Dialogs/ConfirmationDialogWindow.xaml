<local:DialogWindowBase
    x:Class="applanch.Views.Dialogs.ConfirmationDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:applanch.Theming;assembly=applanch.Theming.Wpf"
    Width="452"
    MinWidth="360"
    Background="{DynamicResource Brush.AppBackground}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height">
    <local:DialogWindowBase.Resources>
        <Style BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </local:DialogWindowBase.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="36"
                Height="36"
                Margin="0,1,0,0"
                VerticalAlignment="Top"
                Background="Transparent"
                CornerRadius="18">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="&#xE897;" />
            </Border>

            <ScrollViewer
                Grid.Column="2"
                MaxHeight="240"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="MessageText"
                    FontSize="14"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    LineHeight="22"
                    Text="{Binding DialogMessage}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="NoButton"
                Margin="0,0,8,0"
                Click="NoButton_Click"
                Content="{Binding NoButtonLabel}"
                IsCancel="True" />
            <Button
                x:Name="YesButton"
                Click="YesButton_Click"
                Content="{Binding YesButtonLabel}"
                IsDefault="True" />
        </StackPanel>
    </Grid>
</local:DialogWindowBase>
