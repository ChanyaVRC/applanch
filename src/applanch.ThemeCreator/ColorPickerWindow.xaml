<theming:DialogWindowBase
    x:Class="applanch.ThemeCreator.ColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:applanch.ThemeCreator.Properties"
    xmlns:theming="clr-namespace:applanch.Theming;assembly=applanch.Theming.Wpf"
    Title="{x:Static res:Resources.ColorPickerTitle}"
    Width="560"
    Height="390"
    Background="#F8FAFC"
    FontFamily="Segoe UI"
    FontSize="13"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>

        <!--  Rounded TextBox with focus ring  -->
        <Style x:Key="PickerTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="CaretBrush" Value="#3B82F6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="6"
                                            Opacity="0.22"
                                            ShadowDepth="0"
                                            Color="#3B82F6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Compact value TextBox for RGB channel values  -->
        <Style
            x:Key="ChannelValueTextBox"
            BasedOn="{StaticResource PickerTextBox}"
            TargetType="TextBox">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
        </Style>

        <!--  Compact accent slider  -->
        <Style x:Key="ChannelSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="20" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border
                                Height="4"
                                VerticalAlignment="Center"
                                Background="#E2E8F0"
                                CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border
                                                                Height="4"
                                                                VerticalAlignment="Center"
                                                                Background="#3B82F6"
                                                                CornerRadius="2,0,0,2" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border
                                                                x:Name="td"
                                                                Width="14"
                                                                Height="14"
                                                                Background="#3B82F6"
                                                                BorderBrush="White"
                                                                BorderThickness="2"
                                                                CornerRadius="7">
                                                                <Border.Effect>
                                                                    <DropShadowEffect
                                                                        BlurRadius="4"
                                                                        Opacity="0.2"
                                                                        ShadowDepth="1"
                                                                        Color="Black" />
                                                                </Border.Effect>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="td" Property="Background" Value="#2563EB" />
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="td" Property="Background" Value="#1D4ED8" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="Transparent" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Primary button  -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Light secondary button  -->
        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F9FAFB" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#9CA3AF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Content area  -->
        <Grid Margin="16,16,16,10" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!--  Left: SV square + Hue bar  -->
            <StackPanel>

                <!--  SV picker canvas  -->
                <Border
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="4">
                    <Canvas
                        x:Name="SvCanvas"
                        Width="258"
                        Height="218"
                        Cursor="Cross"
                        MouseDown="SvCanvas_MouseDown"
                        MouseMove="SvCanvas_MouseMove"
                        MouseUp="SvCanvas_MouseUp">
                        <Rectangle
                            x:Name="HueBackground"
                            Width="258"
                            Height="218" />
                        <Rectangle Width="258" Height="218">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="White" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Width="258" Height="218">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="Transparent" />
                                    <GradientStop Offset="1" Color="Black" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Ellipse
                            x:Name="SvCursor"
                            Canvas.Left="0"
                            Canvas.Top="0"
                            Width="14"
                            Height="14"
                            IsHitTestVisible="False"
                            Stroke="White"
                            StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect
                                    BlurRadius="3"
                                    Opacity="0.45"
                                    ShadowDepth="0"
                                    Color="Black" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Border>

                <Border Height="8" />

                <!--  Hue bar  -->
                <Border
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="4">
                    <Canvas
                        x:Name="HueCanvas"
                        Width="258"
                        Height="14"
                        Cursor="Hand"
                        MouseDown="HueCanvas_MouseDown"
                        MouseMove="HueCanvas_MouseMove"
                        MouseUp="HueCanvas_MouseUp">
                        <Rectangle Width="258" Height="14">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FF0000" />
                                    <GradientStop Offset="0.167" Color="#FFFF00" />
                                    <GradientStop Offset="0.333" Color="#00FF00" />
                                    <GradientStop Offset="0.5" Color="#00FFFF" />
                                    <GradientStop Offset="0.667" Color="#0000FF" />
                                    <GradientStop Offset="0.833" Color="#FF00FF" />
                                    <GradientStop Offset="1" Color="#FF0000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border
                            x:Name="HueCursor"
                            Canvas.Left="0"
                            Canvas.Top="-2"
                            Width="4"
                            Height="18"
                            Background="White"
                            CornerRadius="2"
                            IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="3"
                                    Opacity="0.4"
                                    ShadowDepth="0"
                                    Color="Black" />
                            </Border.Effect>
                        </Border>
                    </Canvas>
                </Border>

            </StackPanel>

            <!--  Right: controls panel  -->
            <StackPanel Grid.Column="2" Width="220">

                <!--  Before / After preview  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="11"
                    Foreground="#64748B"
                    Text="{x:Static res:Resources.ColorPickerPreviewLabel}" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="BeforePreview"
                        Height="38"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="6,0,0,6" />
                    <Border
                        x:Name="AfterPreview"
                        Grid.Column="1"
                        Height="38"
                        Margin="-1,0,0,0"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1,1,1,1"
                        CornerRadius="0,6,6,0" />
                </Grid>

                <!--  Hex input  -->
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="11"
                    Foreground="#64748B"
                    Text="{x:Static res:Resources.ColorPickerHexLabel}" />
                <TextBox
                    x:Name="HexTextBox"
                    FontFamily="Consolas, Courier New"
                    MaxLength="9"
                    Style="{StaticResource PickerTextBox}"
                    TextChanged="HexTextBox_TextChanged" />

                <!--  R channel  -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#EF4444"
                        Text="R" />
                    <Slider
                        x:Name="RedSlider"
                        Grid.Column="1"
                        LargeChange="10"
                        Maximum="255"
                        Minimum="0"
                        SmallChange="1"
                        Style="{StaticResource ChannelSlider}"
                        ValueChanged="RgbSlider_ValueChanged" />
                    <TextBox
                        x:Name="RedTextBox"
                        Grid.Column="3"
                        MaxLength="3"
                        Style="{StaticResource ChannelValueTextBox}"
                        TextAlignment="Center"
                        TextChanged="RgbTextBox_TextChanged" />
                </Grid>

                <!--  G channel  -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#22C55E"
                        Text="G" />
                    <Slider
                        x:Name="GreenSlider"
                        Grid.Column="1"
                        LargeChange="10"
                        Maximum="255"
                        Minimum="0"
                        SmallChange="1"
                        Style="{StaticResource ChannelSlider}"
                        ValueChanged="RgbSlider_ValueChanged" />
                    <TextBox
                        x:Name="GreenTextBox"
                        Grid.Column="3"
                        MaxLength="3"
                        Style="{StaticResource ChannelValueTextBox}"
                        TextAlignment="Center"
                        TextChanged="RgbTextBox_TextChanged" />
                </Grid>

                <!--  B channel  -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#3B82F6"
                        Text="B" />
                    <Slider
                        x:Name="BlueSlider"
                        Grid.Column="1"
                        LargeChange="10"
                        Maximum="255"
                        Minimum="0"
                        SmallChange="1"
                        Style="{StaticResource ChannelSlider}"
                        ValueChanged="RgbSlider_ValueChanged" />
                    <TextBox
                        x:Name="BlueTextBox"
                        Grid.Column="3"
                        MaxLength="3"
                        Style="{StaticResource ChannelValueTextBox}"
                        TextAlignment="Center"
                        TextChanged="RgbTextBox_TextChanged" />
                </Grid>

            </StackPanel>
        </Grid>

        <!--  Footer  -->
        <Border
            Grid.Row="1"
            Padding="16,12"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0">
            <DockPanel>
                <Button
                    MinWidth="80"
                    Padding="16,8"
                    Click="Ok_Click"
                    Content="{x:Static res:Resources.ColorPickerOkButton}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}" />
                <Button
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Padding="16,8"
                    Click="Cancel_Click"
                    Content="{x:Static res:Resources.ColorPickerCancelButton}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LightButton}" />
            </DockPanel>
        </Border>
    </Grid>
</theming:DialogWindowBase>
