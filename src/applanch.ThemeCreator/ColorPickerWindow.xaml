<Window x:Class="applanch.ThemeCreator.ColorPickerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:res="clr-namespace:applanch.ThemeCreator.Properties"
	Title="{x:Static res:Resources.ColorPickerTitle}"
	Width="560"
	Height="390"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner"
	FontFamily="Segoe UI"
	FontSize="13"
	Background="#F8FAFC"
	KeyDown="Window_KeyDown">
	<Window.Resources>

		<!-- Rounded TextBox with focus ring -->
		<Style x:Key="PickerTextBox" TargetType="TextBox">
			<Setter Property="Background" Value="White" />
			<Setter Property="Foreground" Value="#0F172A" />
			<Setter Property="CaretBrush" Value="#3B82F6" />
			<Setter Property="BorderBrush" Value="#CBD5E1" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="6">
							<ScrollViewer x:Name="PART_ContentHost"
										  Margin="{TemplateBinding Padding}"
										  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True">
								<Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
								<Setter TargetName="bd" Property="Effect">
									<Setter.Value>
										<DropShadowEffect Color="#3B82F6"
													  Opacity="0.22"
													  BlurRadius="6"
													  ShadowDepth="0" />
									</Setter.Value>
								</Setter>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Compact value TextBox for RGB channel values -->
		<Style x:Key="ChannelValueTextBox" BasedOn="{StaticResource PickerTextBox}" TargetType="TextBox">
			<Setter Property="Padding" Value="4,2" />
			<Setter Property="Height" Value="30" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontFamily" Value="Consolas, Courier New" />
		</Style>

		<!-- Compact accent slider -->
		<Style x:Key="ChannelSlider" TargetType="Slider">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Height" Value="20" />
			<Setter Property="IsMoveToPointEnabled" Value="True" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Slider">
						<Grid>
							<Border Height="4"
									VerticalAlignment="Center"
									Background="#E2E8F0"
									CornerRadius="2" />
							<Track x:Name="PART_Track">
								<Track.DecreaseRepeatButton>
									<RepeatButton IsTabStop="False" Focusable="False">
										<RepeatButton.Style>
											<Style TargetType="RepeatButton">
												<Setter Property="Template">
													<Setter.Value>
														<ControlTemplate TargetType="RepeatButton">
															<Border Height="4"
																	VerticalAlignment="Center"
																	Background="#3B82F6"
																	CornerRadius="2,0,0,2" />
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</RepeatButton.Style>
									</RepeatButton>
								</Track.DecreaseRepeatButton>
								<Track.Thumb>
									<Thumb Width="14" Height="14">
										<Thumb.Style>
											<Style TargetType="Thumb">
												<Setter Property="Template">
													<Setter.Value>
														<ControlTemplate TargetType="Thumb">
															<Border x:Name="td"
																	Width="14" Height="14"
																	CornerRadius="7"
																	Background="#3B82F6"
																	BorderBrush="White"
																	BorderThickness="2">
																<Border.Effect>
																	<DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="4" ShadowDepth="1" />
																</Border.Effect>
															</Border>
															<ControlTemplate.Triggers>
																<Trigger Property="IsMouseOver" Value="True">
																	<Setter TargetName="td" Property="Background" Value="#2563EB" />
																</Trigger>
																<Trigger Property="IsDragging" Value="True">
																	<Setter TargetName="td" Property="Background" Value="#1D4ED8" />
																</Trigger>
															</ControlTemplate.Triggers>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</Thumb.Style>
									</Thumb>
								</Track.Thumb>
								<Track.IncreaseRepeatButton>
									<RepeatButton IsTabStop="False" Focusable="False">
										<RepeatButton.Style>
											<Style TargetType="RepeatButton">
												<Setter Property="Template">
													<Setter.Value>
														<ControlTemplate TargetType="RepeatButton">
															<Border Background="Transparent" />
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</RepeatButton.Style>
									</RepeatButton>
								</Track.IncreaseRepeatButton>
							</Track>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Primary button -->
		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Background" Value="#2563EB" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd"
								Background="{TemplateBinding Background}"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#1D4ED8" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#1E40AF" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Light secondary button -->
		<Style x:Key="LightButton" TargetType="Button">
			<Setter Property="Background" Value="White" />
			<Setter Property="Foreground" Value="#374151" />
			<Setter Property="BorderBrush" Value="#D1D5DB" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F9FAFB" />
								<Setter TargetName="bd" Property="BorderBrush" Value="#9CA3AF" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#F3F4F6" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Content area -->
		<Grid Margin="16,16,16,10"
			  HorizontalAlignment="Center">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="220" />
			</Grid.ColumnDefinitions>

			<!-- Left: SV square + Hue bar -->
			<StackPanel>

				<!-- SV picker canvas -->
				<Border BorderBrush="#E2E8F0"
						BorderThickness="1"
						CornerRadius="4"
						ClipToBounds="True">
					<Canvas x:Name="SvCanvas"
							Width="258" Height="218"
							Cursor="Cross"
							MouseDown="SvCanvas_MouseDown"
							MouseMove="SvCanvas_MouseMove"
							MouseUp="SvCanvas_MouseUp">
						<Rectangle x:Name="HueBackground" Width="258" Height="218" />
						<Rectangle Width="258" Height="218">
							<Rectangle.Fill>
								<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
									<GradientStop Color="White" Offset="0" />
									<GradientStop Color="Transparent" Offset="1" />
								</LinearGradientBrush>
							</Rectangle.Fill>
						</Rectangle>
						<Rectangle Width="258" Height="218">
							<Rectangle.Fill>
								<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
									<GradientStop Color="Transparent" Offset="0" />
									<GradientStop Color="Black" Offset="1" />
								</LinearGradientBrush>
							</Rectangle.Fill>
						</Rectangle>
						<Ellipse x:Name="SvCursor"
								 Width="14" Height="14"
								 Stroke="White"
								 StrokeThickness="2"
								 IsHitTestVisible="False"
								 Canvas.Left="0"
								 Canvas.Top="0">
							<Ellipse.Effect>
								<DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="3" ShadowDepth="0" />
							</Ellipse.Effect>
						</Ellipse>
					</Canvas>
				</Border>

				<Border Height="8" />

				<!-- Hue bar -->
				<Border BorderBrush="#E2E8F0"
						BorderThickness="1"
						CornerRadius="4"
						ClipToBounds="True">
					<Canvas x:Name="HueCanvas"
							Width="258" Height="14"
							Cursor="Hand"
							MouseDown="HueCanvas_MouseDown"
							MouseMove="HueCanvas_MouseMove"
							MouseUp="HueCanvas_MouseUp">
						<Rectangle Width="258" Height="14">
							<Rectangle.Fill>
								<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
									<GradientStop Color="#FF0000" Offset="0" />
									<GradientStop Color="#FFFF00" Offset="0.167" />
									<GradientStop Color="#00FF00" Offset="0.333" />
									<GradientStop Color="#00FFFF" Offset="0.5" />
									<GradientStop Color="#0000FF" Offset="0.667" />
									<GradientStop Color="#FF00FF" Offset="0.833" />
									<GradientStop Color="#FF0000" Offset="1" />
								</LinearGradientBrush>
							</Rectangle.Fill>
						</Rectangle>
						<Border x:Name="HueCursor"
								Width="4" Height="18"
								Background="White"
								CornerRadius="2"
								Canvas.Top="-2"
								Canvas.Left="0"
								IsHitTestVisible="False">
							<Border.Effect>
								<DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="3" ShadowDepth="0" />
							</Border.Effect>
						</Border>
					</Canvas>
				</Border>

			</StackPanel>

			<!-- Right: controls panel -->
			<StackPanel Grid.Column="2" Width="220">

				<!-- Before / After preview -->
				<TextBlock Text="{x:Static res:Resources.ColorPickerPreviewLabel}"
						   Foreground="#64748B"
						   FontSize="11"
						   Margin="0,0,0,6" />
				<Grid Margin="0,0,0,14">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Border x:Name="BeforePreview"
							Height="38"
							CornerRadius="6,0,0,6"
							BorderBrush="#E2E8F0"
							BorderThickness="1" />
					<Border Grid.Column="1"
							x:Name="AfterPreview"
							Height="38"
							CornerRadius="0,6,6,0"
							BorderBrush="#E2E8F0"
							BorderThickness="1,1,1,1"
							Margin="-1,0,0,0" />
				</Grid>

				<!-- Hex input -->
				<TextBlock Text="Hex"
						   Foreground="#64748B"
						   FontSize="11"
						   Margin="0,0,0,4" />
				<TextBox x:Name="HexTextBox"
						 Style="{StaticResource PickerTextBox}"
						 MaxLength="9"
						 FontFamily="Consolas, Courier New"
						 TextChanged="HexTextBox_TextChanged" />

				<!-- R channel -->
				<Grid Margin="0,12,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="14" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="56" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="R"
							   Foreground="#EF4444"
							   FontWeight="SemiBold"
							   FontSize="12"
							   VerticalAlignment="Center" />
					<Slider x:Name="RedSlider"
							Grid.Column="1"
							Style="{StaticResource ChannelSlider}"
							Minimum="0"
							Maximum="255"
							SmallChange="1"
							LargeChange="10"
							ValueChanged="RgbSlider_ValueChanged" />
					<TextBox x:Name="RedTextBox"
							 Grid.Column="3"
							 Style="{StaticResource ChannelValueTextBox}"
							 MaxLength="3"
							 TextAlignment="Center"
							 TextChanged="RgbTextBox_TextChanged" />
				</Grid>

				<!-- G channel -->
				<Grid Margin="0,6,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="14" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="56" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="G"
							   Foreground="#22C55E"
							   FontWeight="SemiBold"
							   FontSize="12"
							   VerticalAlignment="Center" />
					<Slider x:Name="GreenSlider"
							Grid.Column="1"
							Style="{StaticResource ChannelSlider}"
							Minimum="0"
							Maximum="255"
							SmallChange="1"
							LargeChange="10"
							ValueChanged="RgbSlider_ValueChanged" />
					<TextBox x:Name="GreenTextBox"
							 Grid.Column="3"
							 Style="{StaticResource ChannelValueTextBox}"
							 MaxLength="3"
							 TextAlignment="Center"
							 TextChanged="RgbTextBox_TextChanged" />
				</Grid>

				<!-- B channel -->
				<Grid Margin="0,6,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="14" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="56" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="B"
							   Foreground="#3B82F6"
							   FontWeight="SemiBold"
							   FontSize="12"
							   VerticalAlignment="Center" />
					<Slider x:Name="BlueSlider"
							Grid.Column="1"
							Style="{StaticResource ChannelSlider}"
							Minimum="0"
							Maximum="255"
							SmallChange="1"
							LargeChange="10"
							ValueChanged="RgbSlider_ValueChanged" />
					<TextBox x:Name="BlueTextBox"
							 Grid.Column="3"
							 Style="{StaticResource ChannelValueTextBox}"
							 MaxLength="3"
							 TextAlignment="Center"
							 TextChanged="RgbTextBox_TextChanged" />
				</Grid>

			</StackPanel>
		</Grid>

		<!-- Footer -->
		<Border Grid.Row="1"
				Background="White"
				BorderBrush="#E2E8F0"
				BorderThickness="0,1,0,0"
				Padding="16,12">
			<DockPanel>
				<Button DockPanel.Dock="Right"
						Style="{StaticResource PrimaryButton}"
						Content="{x:Static res:Resources.ColorPickerOkButton}"
						MinWidth="80"
						Padding="16,8"
						Click="Ok_Click" />
				<Button DockPanel.Dock="Right"
						Style="{StaticResource LightButton}"
						Content="{x:Static res:Resources.ColorPickerCancelButton}"
						MinWidth="80"
						Padding="16,8"
						Margin="0,0,8,0"
						Click="Cancel_Click" />
			</DockPanel>
		</Border>
	</Grid>
</Window>
