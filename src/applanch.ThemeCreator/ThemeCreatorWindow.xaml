<theming:DialogWindowBase
    x:Class="applanch.ThemeCreator.ThemeCreatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:applanch.ThemeCreator.Properties"
    xmlns:theming="clr-namespace:applanch.Theming;assembly=applanch.Theming.Wpf"
    Title="{x:Static res:Resources.WindowTitle}"
    Width="1100"
    Height="720"
    MinWidth="900"
    MinHeight="580"
    Background="#F8FAFC"
    FontFamily="Segoe UI"
    FontSize="13"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>

        <!--  TextBox with rounded border and focus ring  -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="CaretBrush" Value="#3B82F6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="6"
                                            Opacity="0.22"
                                            ShadowDepth="0"
                                            Color="#3B82F6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Borderless TextBox for DataGrid cells  -->
        <Style x:Key="CellTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Primary accent button  -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#BFDBFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Sidebar secondary button (light surface)  -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Light secondary button (footer / DataGrid)  -->
        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F9FAFB" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#9CA3AF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Sidebar TextBox uses the shared base textbox style  -->
        <Style
            x:Key="SidebarTextBox"
            BasedOn="{StaticResource ModernTextBox}"
            TargetType="TextBox" />

        <!--  Shared ComboBox base style  -->
        <Style x:Key="BaseComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border
                                x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <Path
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M0,0 L4,5 L8,0"
                                        Stroke="#94A3B8"
                                        StrokeThickness="1.5" />
                                </Grid>
                            </Border>
                            <ToggleButton
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup
                                x:Name="Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Fade">
                                <Border
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    MaxHeight="300"
                                    Margin="0,3,0,0"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="14"
                                            Direction="270"
                                            Opacity="0.15"
                                            ShadowDepth="4"
                                            Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="6"
                                            Opacity="0.22"
                                            ShadowDepth="0"
                                            Color="#3B82F6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Foreground" Value="#0F172A" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border
                                    x:Name="bd"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#EFF6FF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#DBEAFE" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!--  Sidebar ComboBox uses the shared base style  -->
        <Style
            x:Key="SidebarComboBox"
            BasedOn="{StaticResource BaseComboBox}"
            TargetType="ComboBox" />

        <!--  RadioButton with custom dot indicator  -->
        <Style x:Key="SidebarRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <DockPanel VerticalAlignment="Center" LastChildFill="True">
                            <Border
                                x:Name="circle"
                                Width="16"
                                Height="16"
                                Margin="0,2,10,0"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderBrush="#94A3B8"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                DockPanel.Dock="Left">
                                <Ellipse
                                    x:Name="dot"
                                    Width="7"
                                    Height="7"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="#3B82F6"
                                    Visibility="Collapsed" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="circle" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="BorderBrush" Value="#64748B" />
                                <Setter Property="Foreground" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  CheckBox with custom square indicator  -->
        <Style x:Key="SidebarCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel VerticalAlignment="Center">
                            <Border
                                x:Name="box"
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="#94A3B8"
                                BorderThickness="1.5"
                                CornerRadius="4"
                                DockPanel.Dock="Left">
                                <TextBlock
                                    x:Name="check"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="✓"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="box" Property="Background" Value="#3B82F6" />
                                <Setter TargetName="box" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ModernComboBox uses the shared base style  -->
        <Style
            x:Key="ModernComboBox"
            BasedOn="{StaticResource BaseComboBox}"
            TargetType="ComboBox" />

        <!--  DataGrid column header  -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SeparatorVisibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border
                            Padding="10,8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  DataGrid row: custom hover/selection colors  -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F9FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  DataGrid cell: transparent so row background shows  -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <!--  Slim dark scrollbar (sidebar)  -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Focusable="False"
                                        Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Margin="1,0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border
                                                    x:Name="thumb"
                                                    Background="#334155"
                                                    CornerRadius="3">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <ColorAnimation
                                                                        Storyboard.TargetName="thumb"
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#475569"
                                                                        Duration="0:0:0.1" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <ColorAnimation
                                                                        Storyboard.TargetName="thumb"
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#64748B"
                                                                        Duration="0:0:0.05" />
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Focusable="False"
                                        Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Slim light scrollbar (editor / DataGrid)  -->
        <Style x:Key="LightScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Focusable="False"
                                        Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Margin="1,0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border
                                                    x:Name="thumb"
                                                    Background="#CBD5E1"
                                                    CornerRadius="3">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <ColorAnimation
                                                                        Storyboard.TargetName="thumb"
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#94A3B8"
                                                                        Duration="0:0:0.1" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <ColorAnimation
                                                                        Storyboard.TargetName="thumb"
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#64748B"
                                                                        Duration="0:0:0.05" />
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Focusable="False"
                                        Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ── Left sidebar ──  -->
            <Border Background="#F1F5F9">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style BasedOn="{StaticResource LightScrollBar}" TargetType="ScrollBar" />
                    </ScrollViewer.Resources>
                    <StackPanel Margin="20,24,20,24">

                        <!--  Creation mode  -->
                        <TextBlock
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#64748B"
                            Text="{x:Static res:Resources.Step1CreationModeHeader}" />
                        <RadioButton
                            x:Name="UseSourcePaletteRadioButton"
                            Margin="0,10,0,0"
                            Checked="CreationModeChanged"
                            Content="{x:Static res:Resources.CreationModeUseSourceOption}"
                            GroupName="CreationMode"
                            IsChecked="True"
                            Style="{StaticResource SidebarRadio}" />
                        <RadioButton
                            x:Name="CreateWithoutSourceRadioButton"
                            Margin="0,10,0,0"
                            Checked="CreationModeChanged"
                            Content="{x:Static res:Resources.CreationModeNoSourceOption}"
                            GroupName="CreationMode"
                            Style="{StaticResource SidebarRadio}" />

                        <!--  Source file  -->
                        <StackPanel x:Name="SourcePanel" Margin="0,20,0,0">
                            <Rectangle Height="1" Fill="#E2E8F0" />
                            <TextBlock
                                Margin="0,18,0,8"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#64748B"
                                Text="{x:Static res:Resources.SourcePaletteLabel}" />
                            <TextBox
                                x:Name="SourcePathTextBox"
                                IsReadOnly="True"
                                IsTabStop="False"
                                Style="{StaticResource SidebarTextBox}"
                                TextChanged="SourcePathChanged" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="BrowseSourceButton"
                                    Padding="0,6"
                                    Click="BrowseSource_Click"
                                    Content="{x:Static res:Resources.BrowseButton}"
                                    Style="{StaticResource SidebarButton}" />
                                <Button
                                    Grid.Column="2"
                                    Padding="0,6"
                                    Click="ReloadSource_Click"
                                    Content="{x:Static res:Resources.ReloadButton}"
                                    Style="{StaticResource SidebarButton}" />
                            </Grid>
                        </StackPanel>

                        <!--  Theme basics  -->
                        <Rectangle
                            Height="1"
                            Margin="0,20,0,0"
                            Fill="#E2E8F0" />
                        <TextBlock
                            Margin="0,18,0,0"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#64748B"
                            Text="{x:Static res:Resources.Step3ThemeBasicsHeader}" />

                        <TextBlock
                            Margin="0,14,0,5"
                            FontSize="11"
                            Foreground="#94A3B8"
                            Text="{x:Static res:Resources.ThemeIdLabel}" />
                        <TextBox
                            x:Name="ThemeIdTextBox"
                            Style="{StaticResource SidebarTextBox}"
                            TextChanged="ThemeIdChanged" />

                        <TextBlock
                            Margin="0,12,0,5"
                            FontSize="11"
                            Foreground="#94A3B8"
                            Text="{x:Static res:Resources.BaseThemeLabel}" />
                        <ComboBox
                            x:Name="BaseThemeComboBox"
                            SelectionChanged="BaseThemeSelectionChanged"
                            Style="{StaticResource SidebarComboBox}" />

                        <CheckBox
                            x:Name="IncludeEntriesCheckBox"
                            Margin="0,14,0,0"
                            Checked="MetadataChanged"
                            Content="{x:Static res:Resources.IncludeEntriesLabel}"
                            IsChecked="True"
                            Style="{StaticResource SidebarCheckBox}"
                            Unchecked="MetadataChanged" />

                        <!--  Display names  -->
                        <Rectangle
                            Height="1"
                            Margin="0,20,0,0"
                            Fill="#E2E8F0" />
                        <TextBlock
                            Margin="0,18,0,10"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#64748B"
                            Text="{x:Static res:Resources.Step4DisplayNamesHeader}" />
                        <ItemsControl x:Name="LocalizedNamesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="11"
                                            Foreground="#64748B"
                                            Text="{Binding Label}" />
                                        <TextBox
                                            Style="{StaticResource SidebarTextBox}"
                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="NameEntryChanged" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Output path  -->
                        <Rectangle
                            Height="1"
                            Margin="0,10,0,0"
                            Fill="#E2E8F0" />
                        <TextBlock
                            Margin="0,18,0,8"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#64748B"
                            Text="{x:Static res:Resources.Step5OutputHeader}" />
                        <TextBox
                            x:Name="OutputPathTextBox"
                            IsReadOnly="True"
                            IsTabStop="False"
                            Style="{StaticResource SidebarTextBox}"
                            TextChanged="OutputPathChanged" />
                        <Button
                            x:Name="BrowseOutputButton"
                            Margin="0,6,0,0"
                            Padding="0,6"
                            Click="BrowseOutput_Click"
                            Content="{x:Static res:Resources.BrowseButton}"
                            Style="{StaticResource SidebarButton}" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  ── Right: color editor ──  -->
            <Border
                x:Name="EditorStepPanel"
                Grid.Column="1"
                Padding="24,20"
                Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="{x:Static res:Resources.EditorLabel}" />
                    <TextBlock
                        Grid.Row="2"
                        FontSize="12"
                        Foreground="#64748B"
                        Text="{x:Static res:Resources.EditorHint}"
                        TextWrapping="Wrap" />

                    <DataGrid
                        x:Name="EntriesDataGrid"
                        Grid.Row="4"
                        AlternatingRowBackground="#F8FAFC"
                        AutoGenerateColumns="False"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="False"
                        RowHeaderWidth="0"
                        RowHeight="44"
                        SelectionUnit="FullRow">
                        <DataGrid.Resources>
                            <Style BasedOn="{StaticResource LightScrollBar}" TargetType="ScrollBar" />
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Width="68"
                                Header="{x:Static res:Resources.EntryPreviewHeader}"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="10,0"
                                            Click="PickEntryColor_Click"
                                            Cursor="Hand"
                                            Focusable="False"
                                            ToolTip="{x:Static res:Resources.PickColorButton}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        x:Name="swatch"
                                                        Width="32"
                                                        Height="18"
                                                        Background="{Binding PreviewBrush}"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="1"
                                                        CornerRadius="4" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="swatch" Property="BorderBrush" Value="#94A3B8" />
                                                            <Setter TargetName="swatch" Property="BorderThickness" Value="1.5" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="swatch" Property="Opacity" Value="0.75" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="220"
                                Binding="{Binding Key}"
                                Header="{x:Static res:Resources.EntryKeyHeader}"
                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                        <Setter Property="FontFamily" Value="Consolas, Courier New" />
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Description}"
                                Header="{x:Static res:Resources.EntryUsageHeader}"
                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="#475569" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="150" Header="{x:Static res:Resources.EntryHexHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            Style="{StaticResource CellTextBox}"
                                            Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="EntryHexChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!--  ── Footer action bar ──  -->
        <Border
            Grid.Row="1"
            Padding="20,12"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0">
            <DockPanel>
                <Button
                    x:Name="CreateButton"
                    MinWidth="136"
                    Padding="16,8"
                    Click="Create_Click"
                    Content="{x:Static res:Resources.CreateButton}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource PrimaryButton}" />
                <Button
                    x:Name="OpenAppPreviewButton"
                    MinWidth="132"
                    Margin="0,0,8,0"
                    Padding="14,8"
                    Click="OpenAppPreview_Click"
                    Content="{x:Static res:Resources.OpenAppPreviewButton}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LightButton}" />
                <Button
                    x:Name="OpenPreviewButton"
                    MinWidth="118"
                    Margin="0,0,8,0"
                    Padding="14,8"
                    Click="OpenPreview_Click"
                    Content="{x:Static res:Resources.OpenPreviewButton}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LightButton}" />
                <TextBlock
                    x:Name="StatusTextBlock"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#64748B" />
            </DockPanel>
        </Border>
    </Grid>
</theming:DialogWindowBase>



