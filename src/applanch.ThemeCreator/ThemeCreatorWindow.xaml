<Window x:Class="applanch.ThemeCreator.ThemeCreatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:applanch.ThemeCreator.Properties"
    mc:Ignorable="d"
    Title="{x:Static res:Resources.WindowTitle}"
    Width="1100"
    Height="720"
    MinWidth="900"
    MinHeight="580"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI"
    FontSize="13"
    Background="#F8FAFC">
    <Window.Resources>

        <!-- TextBox with rounded border and focus ring -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="CaretBrush" Value="#3B82F6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3B82F6"
                                                          Opacity="0.22"
                                                          BlurRadius="6"
                                                          ShadowDepth="0" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless TextBox for DataGrid cells -->
        <Style x:Key="CellTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary accent button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#BFDBFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar secondary button (light surface) -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light secondary button (footer / DataGrid) -->
        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F9FAFB" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#9CA3AF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar TextBox uses the shared base textbox style -->
        <Style x:Key="SidebarTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}" />

        <!-- Shared ComboBox base style -->
        <Style x:Key="BaseComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" />
                                    <Path Grid.Column="1"
                                          Data="M0,0 L4,5 L8,0"
                                        Stroke="#94A3B8"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="300"
                                        Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,3,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="14" ShadowDepth="4" Direction="270" />
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#3B82F6"
                                                          Opacity="0.22"
                                                          BlurRadius="6"
                                                          ShadowDepth="0" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Foreground" Value="#0F172A" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#EFF6FF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#DBEAFE" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Sidebar ComboBox uses the shared base style -->
        <Style x:Key="SidebarComboBox" TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}" />

        <!-- RadioButton with custom dot indicator -->
        <Style x:Key="SidebarRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <DockPanel VerticalAlignment="Center" LastChildFill="True">
                            <Border x:Name="circle"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1.5"
                                    Background="Transparent"
                                    DockPanel.Dock="Left"
                                    Margin="0,2,10,0"
                                    VerticalAlignment="Top">
                                <Ellipse x:Name="dot"
                                         Width="7" Height="7"
                                         Fill="#3B82F6"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                            </Border>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="circle" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="BorderBrush" Value="#64748B" />
                                <Setter Property="Foreground" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox with custom square indicator -->
        <Style x:Key="SidebarCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel VerticalAlignment="Center">
                            <Border x:Name="box"
                                    Width="16" Height="16"
                                    CornerRadius="4"
                                    BorderBrush="#94A3B8"
                                    BorderThickness="1.5"
                                    Background="Transparent"
                                    DockPanel.Dock="Left"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="check"
                                           Text="✓"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="box" Property="Background" Value="#3B82F6" />
                                <Setter TargetName="box" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ModernComboBox uses the shared base style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource BaseComboBox}" />

        <!-- DataGrid column header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SeparatorVisibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1"
                                Padding="10,8">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid row: custom hover/selection colors -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F9FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid cell: transparent so row background shows -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Slim dark scrollbar (sidebar) -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Margin="1,0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumb" CornerRadius="3" Background="#334155">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#475569" Duration="0:0:0.1" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#64748B" Duration="0:0:0.05" />
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim light scrollbar (editor / DataGrid) -->
        <Style x:Key="LightScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Margin="1,0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumb" CornerRadius="3" Background="#CBD5E1">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#94A3B8" Duration="0:0:0.1" />
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#64748B" Duration="0:0:0.05" />
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Left sidebar ── -->
            <Border Background="#F1F5F9">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource LightScrollBar}" />
                    </ScrollViewer.Resources>
                    <StackPanel Margin="20,24,20,24">

                        <!-- Creation mode -->
                        <TextBlock Text="{x:Static res:Resources.Step1CreationModeHeader}"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Bold"
 />
                        <RadioButton Style="{StaticResource SidebarRadio}"
                                     x:Name="UseSourcePaletteRadioButton"
                                     GroupName="CreationMode"
                                     IsChecked="True"
                                     Checked="CreationModeChanged"
                                     Content="{x:Static res:Resources.CreationModeUseSourceOption}"
                                     Margin="0,10,0,0" />
                        <RadioButton Style="{StaticResource SidebarRadio}"
                                     x:Name="CreateWithoutSourceRadioButton"
                                     GroupName="CreationMode"
                                     Checked="CreationModeChanged"
                                     Content="{x:Static res:Resources.CreationModeNoSourceOption}"
                                     Margin="0,10,0,0" />

                        <!-- Source file -->
                        <StackPanel x:Name="SourcePanel" Margin="0,20,0,0">
                            <Rectangle Height="1" Fill="#E2E8F0" />
                            <TextBlock Text="{x:Static res:Resources.SourcePaletteLabel}"
                                       Foreground="#64748B"
                                       FontSize="10"
                                       FontWeight="Bold"

                                       Margin="0,18,0,8" />
                            <TextBox x:Name="SourcePathTextBox"
                                     Style="{StaticResource SidebarTextBox}"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     TextChanged="SourcePathChanged" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BrowseSourceButton"
                                        Style="{StaticResource SidebarButton}"
                                    Padding="0,6"
                                        Click="BrowseSource_Click"
                                        Content="{x:Static res:Resources.BrowseButton}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource SidebarButton}"
                                    Padding="0,6"
                                        Click="ReloadSource_Click"
                                        Content="{x:Static res:Resources.ReloadButton}" />
                            </Grid>
                        </StackPanel>

                        <!-- Theme basics -->
                        <Rectangle Height="1" Fill="#E2E8F0" Margin="0,20,0,0" />
                        <TextBlock Text="{x:Static res:Resources.Step3ThemeBasicsHeader}"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Bold"

                                   Margin="0,18,0,0" />

                        <TextBlock Text="{x:Static res:Resources.ThemeIdLabel}"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   Margin="0,14,0,5" />
                        <TextBox x:Name="ThemeIdTextBox"
                                 Style="{StaticResource SidebarTextBox}"
                                 TextChanged="ThemeIdChanged" />

                        <TextBlock Text="{x:Static res:Resources.BaseThemeLabel}"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   Margin="0,12,0,5" />
                        <ComboBox x:Name="BaseThemeComboBox"
                                  Style="{StaticResource SidebarComboBox}"
                                  SelectionChanged="BaseThemeSelectionChanged" />

                        <CheckBox x:Name="IncludeEntriesCheckBox"
                                  Style="{StaticResource SidebarCheckBox}"
                                  Content="{x:Static res:Resources.IncludeEntriesLabel}"
                                  Checked="MetadataChanged"
                                  Unchecked="MetadataChanged"
                                  IsChecked="True"
                                  Margin="0,14,0,0" />

                        <!-- Display names -->
                        <Rectangle Height="1" Fill="#E2E8F0" Margin="0,20,0,0" />
                        <TextBlock Text="{x:Static res:Resources.Step4DisplayNamesHeader}"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Bold"

                                   Margin="0,18,0,10" />
                        <ItemsControl x:Name="LocalizedNamesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource SidebarTextBox}"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="NameEntryChanged" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Output path -->
                        <Rectangle Height="1" Fill="#E2E8F0" Margin="0,10,0,0" />
                        <TextBlock Text="{x:Static res:Resources.Step5OutputHeader}"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Bold"

                                   Margin="0,18,0,8" />
                        <TextBox x:Name="OutputPathTextBox"
                                 Style="{StaticResource SidebarTextBox}"
                                 IsReadOnly="True"
                                 IsTabStop="False"
                                 TextChanged="OutputPathChanged" />
                        <Button x:Name="BrowseOutputButton"
                                Style="{StaticResource SidebarButton}"
                            Padding="0,6"
                                Margin="0,6,0,0"
                                Click="BrowseOutput_Click"
                                Content="{x:Static res:Resources.BrowseButton}" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── Right: color editor ── -->
            <Border Grid.Column="1"
                    x:Name="EditorStepPanel"
                    Background="White"
                    Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="#0F172A"
                               Text="{x:Static res:Resources.EditorLabel}" />
                    <TextBlock Grid.Row="2"
                               Foreground="#64748B"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{x:Static res:Resources.EditorHint}" />

                    <DataGrid Grid.Row="4"
                              x:Name="EntriesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="False"
                              RowHeaderWidth="0"
                              GridLinesVisibility="None"
                              BorderThickness="1"
                              BorderBrush="#E2E8F0"
                              Background="White"
                              AlternatingRowBackground="#F8FAFC"
                              RowHeight="44"
                              SelectionUnit="FullRow">
                                                <DataGrid.Resources>
                                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource LightScrollBar}" />
                                                </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{x:Static res:Resources.EntryPreviewHeader}" Width="68" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="PickEntryColor_Click"
                                                Cursor="Hand"
                                                Focusable="False"
                                                ToolTip="{x:Static res:Resources.PickColorButton}"
                                                Margin="10,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="swatch"
                                                            Width="32" Height="18"
                                                            CornerRadius="4"
                                                            BorderBrush="#E2E8F0"
                                                            BorderThickness="1"
                                                            Background="{Binding PreviewBrush}" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="swatch" Property="BorderBrush" Value="#94A3B8" />
                                                            <Setter TargetName="swatch" Property="BorderThickness" Value="1.5" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="swatch" Property="Opacity" Value="0.75" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static res:Resources.EntryKeyHeader}"
                                               Binding="{Binding Key}"
                                               IsReadOnly="True"
                                               Width="220">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                        <Setter Property="FontFamily" Value="Consolas, Courier New" />
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{x:Static res:Resources.EntryUsageHeader}"
                                               Binding="{Binding Description}"
                                               IsReadOnly="True"
                                               Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="10,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="#475569" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Resources.EntryHexHeader}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellTextBox}"
                                                 Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="EntryHexChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer action bar ── -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        x:Name="CreateButton"
                        Style="{StaticResource PrimaryButton}"
                    MinWidth="136"
                    Padding="16,8"
                        Click="Create_Click"
                        Content="{x:Static res:Resources.CreateButton}" />
                <Button DockPanel.Dock="Right"
                    x:Name="OpenAppPreviewButton"
                    Style="{StaticResource LightButton}"
                    Margin="0,0,8,0"
                    MinWidth="132"
                    Padding="14,8"
                    Click="OpenAppPreview_Click"
                    Content="{x:Static res:Resources.OpenAppPreviewButton}" />
                <Button DockPanel.Dock="Right"
                        x:Name="OpenPreviewButton"
                        Style="{StaticResource LightButton}"
                        Margin="0,0,8,0"
                    MinWidth="118"
                    Padding="14,8"
                        Click="OpenPreview_Click"
                        Content="{x:Static res:Resources.OpenPreviewButton}" />
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="12" />
            </DockPanel>
        </Border>
    </Grid>
</Window>



