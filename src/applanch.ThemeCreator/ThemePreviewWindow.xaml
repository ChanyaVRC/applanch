<theming:DialogWindowBase
    x:Class="applanch.ThemeCreator.ThemePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="clr-namespace:applanch.ThemeCreator.Properties"
    xmlns:theming="clr-namespace:applanch.Theming;assembly=applanch.Theming.Wpf"
    Title="{x:Static res:Resources.PreviewWindowTitle}"
    Width="760"
    Height="820"
    MinWidth="520"
    MinHeight="420"
    Background="#0F172A"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <TextBox
            x:Name="PreviewTextBox"
            AcceptsReturn="True"
            AcceptsTab="True"
            Background="#0F172A"
            BorderThickness="0"
            FontFamily="Consolas"
            FontSize="13"
            Foreground="#E2E8F0"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />
    </Grid>
</theming:DialogWindowBase>
