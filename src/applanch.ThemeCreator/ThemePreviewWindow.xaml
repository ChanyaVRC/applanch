<Window x:Class="applanch.ThemeCreator.ThemePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:applanch.ThemeCreator.Properties"
        Title="{x:Static res:Resources.PreviewWindowTitle}"
        Width="760"
        Height="820"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">
    <Grid Margin="16">
        <TextBox x:Name="PreviewTextBox"
                 FontFamily="Consolas"
                 FontSize="13"
                 Foreground="#E2E8F0"
                 Background="#0F172A"
                 BorderThickness="0"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
    </Grid>
</Window>
